# deploy-testnet.env.example
#
# Copy this file to deploy-testnet.env, fill in your values, then:
#   source deploy-testnet.env && ./deploy-testnet.sh
#
# NEVER commit deploy-testnet.env — it contains your secret key.

# Your Stellar account secret key (S...) or a named identity from
# `stellar keys ls`. The account must be funded on the target network.
STELLAR_SOURCE=your-identity-name-or-secret-key

# Network to deploy to. Defaults to testnet if not set.
# Valid values: testnet, mainnet, futurenet, standalone
NETWORK=testnet
